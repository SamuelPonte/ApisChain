digraph G { rankdir=TB; newrank=true; compound=true; nodesep=0.35; ranksep=0.55; bgcolor="white";
graph [fontname="DejaVu Sans", fontsize=12, labeljust=l]; node [shape=plaintext, fontname="DejaVu Sans", fontsize=10]; edge [fontname="DejaVu Sans", fontsize=9, color="#555555"];
labelloc=t; label=<<B>ApisChain · Diagrama de classes v1</B><BR/><FONT POINT-SIZE="10">Verde: implementado (11 nov) · Branco: previsto para a PoC</FONT>>; fontsize=16;
subgraph cluster_core { label="apischain.core"; style="rounded"; color="#999999";
Block [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#E8F3EA"><B>Block</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- index: int<BR/>- timestamp: long<BR/>- previousHash: String<BR/>- transactions: List&lt;String&gt;<BR/>- merkleRoot: String<BR/>- validator: String<BR/>- currentHash: String<BR/>- signature: String<BR/>- votes: List&lt;Vote&gt;</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ calculateHash(): String<BR/>+ isValid(): boolean<BR/>+ getMerkleTree(): MerkleTree<BR/>+ setSignature(s)<BR/>+ addVote(v: Vote)</TD></TR></TABLE>>];
BlockChain [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#E8F3EA"><B>BlockChain</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- chain: ArrayList&lt;Block&gt;</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ add(b: Block): boolean<BR/>+ isValid(): boolean<BR/>+ getInvalidIndex(): int<BR/>+ getLastBlockHash(): String<BR/>+ save(f) / load(f)</TD></TR></TABLE>>];
MerkleTree [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#E8F3EA"><B>MerkleTree</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- hashTree: List&lt;List&lt;String&gt;&gt;<BR/>- elements: List&lt;String&gt;</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ getRoot(): String<BR/>+ getProof(data): List&lt;String&gt;<BR/>+ isProofValid(data, proof): boolean<BR/>+ isValid(): boolean</TD></TR></TABLE>>];
Vote [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#E8F3EA"><B>Vote</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- validator: String<BR/>- signature: String</TD></TR></TABLE>>];
}
subgraph cluster_utils { label="apischain.utils"; style="rounded"; color="#999999";
SecurityUtils [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#E8F3EA"><B>SecurityUtils</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ getHash(data): String<BR/>+ generateKeyPair(): KeyPair<BR/>+ sign(data, priv): String<BR/>+ verify(data, sig, pub): boolean<BR/>+ keyToBase64(key) / publicKeyFromBase64(txt)</TD></TR></TABLE>>];
Conversion [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#E8F3EA"><B>Conversion</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ objectToBase64(obj): String<BR/>+ base64ToObject(txt): T</TD></TR></TABLE>>];
}
subgraph cluster_identity { label="apischain.identity"; style="rounded"; color="#999999";
Role [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#FFFFFF"><FONT POINT-SIZE="9">&laquo;enum&raquo;</FONT><BR/><B>Role</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">DGAV, LAB, DOP,<BR/>APICULTOR, LOJA</TD></TR></TABLE>>];
Identity [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#FFFFFF"><B>Identity</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- name: String<BR/>- role: Role<BR/>- keyPair: KeyPair<BR/>- did: String</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ getDid(): String<BR/>+ getPublicKeyBase64(): String<BR/>+ sign(data): String</TD></TR></TABLE>>];
CredentialType [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#FFFFFF"><FONT POINT-SIZE="9">&laquo;enum&raquo;</FONT><BR/><B>CredentialType</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">REGISTO_APICULTOR, REGISTO_APIARIO,<BR/>REGISTO_LOJA, LOTE,<BR/>ANALISE_LOTE, CERTIFICADO_ORIGEM</TD></TR></TABLE>>];
Credential [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#FFFFFF"><B>Credential</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- id: String<BR/>- type: CredentialType<BR/>- issuer: String (DID)<BR/>- subject: String<BR/>- data: Map&lt;String,String&gt;<BR/>- issuedAt: long<BR/>- signature: String</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ getHash(): String<BR/>+ sign(issuer: Identity)<BR/>+ isSignatureValid(pub): boolean</TD></TR></TABLE>>];
OffChainStore [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#FFFFFF"><B>OffChainStore</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- credentials: Map&lt;String,Credential&gt;</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ put(c) / get(id)<BR/>+ save(f) / load(f)</TD></TR></TABLE>>];
}
subgraph cluster_tx { label="apischain.transactions"; style="rounded"; color="#999999";
Transaction [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#FFFFFF"><FONT POINT-SIZE="9">&laquo;abstract&raquo;</FONT><BR/><B>Transaction</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- author: String (DID)<BR/>- timestamp: long<BR/>- signature: String</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ getContent(): String<BR/>+ sign(id: Identity)<BR/>+ isSignatureValid(pub): boolean<BR/>+ toBase64(): String</TD></TR></TABLE>>];
GenesisTx [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#FFFFFF"><B>GenesisTx</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- authorities: List&lt;Authority&gt;</TD></TR></TABLE>>];
IssueCredentialTx [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#FFFFFF"><B>IssueCredentialTx</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- credentialId, credentialType<BR/>- subject, credentialHash<BR/>- subjectKey (opcional)</TD></TR></TABLE>>];
RevokeTx [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#FFFFFF"><B>RevokeTx</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- credentialId<BR/>- reason</TD></TR></TABLE>>];
PackTx [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#FFFFFF"><B>PackTx</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- lot<BR/>- firstJar, lastJar<BR/>- weightKg</TD></TR></TABLE>>];
SaleTx [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#FFFFFF"><B>SaleTx</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- jarId<BR/>- shop</TD></TR></TABLE>>];
FraudAlertTx [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#FFFFFF"><B>FraudAlertTx</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- jarId<BR/>- reason</TD></TR></TABLE>>];
}
subgraph cluster_ledger { label="apischain.ledger"; style="rounded"; color="#999999";
LedgerState [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#FFFFFF"><B>LedgerState</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- chain: BlockChain</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ publicKeyOf(did): PublicKey<BR/>+ roleOf(did): Role<BR/>+ isRevoked(credId): boolean<BR/>+ lotBalance(lot): Balance<BR/>+ isSold(jarId): boolean</TD></TR></TABLE>>];
Rules [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#FFFFFF"><B>Rules</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">TOLERANCE = 0.02</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ check(tx, state): Transaction<BR/>   (rejeita ou converte em FraudAlertTx)</TD></TR></TABLE>>];
}
subgraph cluster_consensus { label="apischain.consensus"; style="rounded"; color="#999999";
PeerNode [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#FFFFFF"><B>PeerNode</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- id: String<BR/>- authority: Identity (ou null)<BR/>- chain: BlockChain<BR/>- online: boolean</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ validate(b): Vote<BR/>+ commit(b): boolean<BR/>+ syncFrom(other: Node)</TD></TR></TABLE>>];
ProofOfAuthority [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#FFFFFF"><B>ProofOfAuthority</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- validators: List&lt;Node&gt;</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ selectProposer(height): Node<BR/>+ propose(txs): Block<BR/>+ quorum(): int   (n/2 + 1)</TD></TR></TABLE>>];
LocalNetwork [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#FFFFFF"><B>LocalNetwork</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- nodes: List&lt;Node&gt;<BR/>- log: List&lt;String&gt;</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ broadcast(b: Block)<BR/>+ setOnline(node, on)</TD></TR></TABLE>>];
}
subgraph cluster_service { label="apischain.service"; style="rounded"; color="#999999";
ApisChainService [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#FFFFFF"><FONT POINT-SIZE="9">&laquo;fachada&raquo;</FONT><BR/><B>ApisChainService</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- network, poa, offChain</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ registerBeekeeper(...) / registerApiary(...)<BR/>+ createLot(...) / issueAnalysis(...)<BR/>+ issueCertificate(...) / revoke(...)<BR/>+ packJars(...) / sellJar(...)<BR/>+ verifyJar(id): VerificationResult</TD></TR></TABLE>>];
VerificationResult [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#FFFFFF"><B>VerificationResult</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- level: OK | AVISO | FALHA<BR/>- title: String<BR/>- checks: List&lt;String&gt;</TD></TR></TABLE>>];
}
subgraph cluster_gui { label="apischain.gui"; style="rounded"; color="#999999";
MainFrame [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#FFFFFF"><FONT POINT-SIZE="9">&laquo;Swing&raquo;</FONT><BR/><B>MainFrame (JFrame)</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- tabs: JTabbedPane</TD></TR></TABLE>>];
Panels [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#FFFFFF"><FONT POINT-SIZE="9">&laquo;Swing&raquo;</FONT><BR/><B>Painéis (JPanel)</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">ConsumerPanel, BeekeeperPanel,<BR/>LabPanel, DopPanel, ShopPanel,<BR/>DgavPanel, ChainPanel, NetworkPanel,<BR/>MerkleTreePanel (das aulas)</TD></TR></TABLE>>];
}
