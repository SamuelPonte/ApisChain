digraph A {
  rankdir=TB; newrank=true; nodesep=0.3; ranksep=0.5; bgcolor="white";
  graph [fontname="DejaVu Sans", fontsize=12, labeljust=l];
  node [fontname="DejaVu Sans", fontsize=10, shape=box, style="rounded,filled", fillcolor="white", color="#666666"];
  edge [fontname="DejaVu Sans", fontsize=9, color="#555555"];
  labelloc=t; label=<<B>ApisChain · Arquitetura do serviço (PoC da Fase 2)</B><BR/><FONT POINT-SIZE="10">Tudo corre num só computador; na Fase 3 a rede local é substituída por sockets TCP entre máquinas</FONT>>; fontsize=16;

  subgraph cluster_act { label="Intervenientes"; style=rounded; color="#999999";
    dgav [label="DGAV\nregista apicultores,\napiários e lojas; revoga"];
    lab  [label="Laboratório\nemite análise do lote"];
    dop  [label="Certificador DOP\nemite certificado de origem"];
    api  [label="Apicultor\ncria lotes e embala\nfrascos com QR"];
    loja [label="Loja\nregista a venda\nde cada frasco"];
    cons [label="Consumidor\nverifica o QR\ndo frasco"];
  }
  gui [label="Interface Swing\num separador por interveniente + explorador da cadeia + rede", fillcolor="#EEF3FB"];
  svc [label="ApisChainService (fachada)\ncria credenciais e transações assinadas · verifica frascos", fillcolor="#EEF3FB"];

  subgraph cluster_poa { label="Consenso Proof of Authority com votação"; style=rounded; color="#999999";
    rules [label="Regras dos validadores\nassinatura e papel do autor · balanço de massa (2%)\nvenda dupla → ALERTA_FRAUDE · revogações", fillcolor="#FFF6E5"];
    poa [label="1. proponente rotativo propõe o bloco\n2. as outras autoridades validam e votam (assinam)\n3. com 2 votos em 3 o bloco entra em todos os nós", fillcolor="#FFF6E5"];
  }
  subgraph cluster_net { label="Rede local (LocalNetwork)"; style=rounded; color="#999999";
    n1 [label="N1 · DGAV\nvalidador\ncópia da cadeia", shape=box3d];
    n2 [label="N2 · Laboratório\nvalidador\ncópia da cadeia", shape=box3d];
    n3 [label="N3 · DOP\nvalidador\ncópia da cadeia", shape=box3d];
    n4 [label="N4 · Apicultores, lojas\ne consumidores\nsó leitura e verificação", shape=box3d];
  }
  subgraph cluster_data { label="Onde ficam os dados (RGPD)"; style=rounded; color="#999999";
    on  [label="Na cadeia (on-chain)\nDIDs e chaves públicas · hashes das credenciais\nembalagens, vendas, alertas · revogações", shape=cylinder, fillcolor="#E8F3EA"];
    off [label="Fora da cadeia (off-chain)\ncredenciais completas assinadas\nnomes, NIF, coordenadas dos apiários", shape=cylinder, fillcolor="#F4F4F4"];
  }
  {dgav lab dop api loja cons} -> gui [arrowhead=none, color="#AAAAAA"];
  gui -> svc;
  svc -> rules [label="transações"];
  rules -> poa;
  poa -> n1; poa -> n2; poa -> n3; poa -> n4 [style=dashed, label="propaga"];
  n1 -> on [style=dashed, arrowhead=none]; n2 -> on [style=dashed, arrowhead=none]; n3 -> on [style=dashed, arrowhead=none]; n4 -> on [style=dashed, arrowhead=none];
  svc -> off [label="guarda credencial;\nancora só o hash"];
}
